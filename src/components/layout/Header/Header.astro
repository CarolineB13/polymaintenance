---
import { Image } from "astro:assets";

import logo from "../../../assets/logos/logo.png";
import Button from "../../ui/Button/Button.astro";
import HeaderMobile from "./HeaderMobile";
import { site } from "../../../config/site";
import "./Header.css";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { href: "/maintenance", label: "Maintenance" },
  { href: "/installation", label: "Installation" },
  { href: "/negoce", label: "Négoce" },
  { href: "/formation", label: "Formation" },
  ...(site.features.materialCatalog
    ? [{ href: "/materiel-industriel", label: "Matériel à vendre" }]
    : []),
];
---

<header class="site-header">
  <div class="header-container">
    <a href="/" class="logo-link" aria-label="Accueil Polymaintenance">
      <Image
        src={logo}
        alt="Logo Polymaintenance"
        class="logo"
        widths={[230, 460]}
        sizes="230px"
        loading="eager"
      />
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      <ul class="nav">
        {
          navLinks.map((link) => (
            <li>
              <a
                class="nav-link"
                href={link.href}
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="header-phone"
            href={`tel:${site.phone.replaceAll(" ", "")}`}
            aria-label={`Appeler Hervé au ${site.phone}`}
          >
            <span>Appeler Hervé</span>
            <strong>{site.phone}</strong>
          </a>
        </li>
        <li>
          <Button href="/contact" label="Demander un devis" />
        </li>
      </ul>
    </nav>

    <HeaderMobile
      client:load
      phone={site.phone}
      currentPath={currentPath}
      showMaterialCatalog={site.features.materialCatalog}
    />
  </div>
</header>
