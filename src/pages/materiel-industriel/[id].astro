---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button/Button.astro";
import Container from "../../components/ui/Container/Container.astro";
import { site } from "../../config/site";
import {
  categoryLabels,
  conditionLabels,
  formatProductPrice,
  statusLabels,
} from "../../utils/products";

import "./product-detail.css";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const price = formatProductPrice(data.priceType, data.price);

const availabilitySchema = {
  available: "https://schema.org/InStock",
  reserved: "https://schema.org/LimitedAvailability",
  sold: "https://schema.org/OutOfStock",
};

const conditionSchema = {
  neuf: "https://schema.org/NewCondition",
  occasion: "https://schema.org/UsedCondition",
  reconditionne: "https://schema.org/RefurbishedCondition",
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: data.title,
  description: data.description,
  sku: product.id,
  ...(data.brand && {
    brand: {
      "@type": "Brand",
      name: data.brand,
    },
  }),
  ...(data.model && { model: data.model }),
  itemCondition: conditionSchema[data.condition],
  offers: {
    "@type": "Offer",
    url: new URL(Astro.url.pathname, site.url).toString(),
    priceCurrency: "EUR",
    availability: availabilitySchema[data.status],
    ...(data.priceType === "fixed" && data.price && { price: data.price }),
    seller: {
      "@type": "Organization",
      name: site.name,
      url: site.url,
    },
  },
};
---

<Layout
  title={`${data.title} – ${conditionLabels[data.condition]}`}
  description={data.description}
>
  {
    !data.demo && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(productSchema)}
      />
    )
  }

  <section class="product-detail" aria-labelledby="product-title">
    <Container>
      <a href="/materiel-industriel" class="product-detail__back"
        >← Retour au matériel</a
      >

      {
        data.demo && (
          <div class="product-detail__demo" role="note">
            Annonce de démonstration : les caractéristiques seront remplacées
            par les informations du matériel réel.
          </div>
        )
      }

      <div class="product-detail__hero">
        <div class="product-detail__visual">
          <Image
            src={data.image}
            alt={data.imageAlt}
            widths={[640, 1000, 1400]}
            sizes="(max-width: 900px) 100vw, 58vw"
          />
        </div>

        <div class="product-detail__summary">
          <div class="product-detail__badges">
            <span>{categoryLabels[data.category]}</span>
            <span
              class={`product-detail__status product-detail__status--${data.status}`}
            >
              {statusLabels[data.status]}
            </span>
          </div>

          <h1 id="product-title">{data.title}</h1>
          <p class="product-detail__description">{data.description}</p>
          <p class="product-detail__price">{price}</p>

          <dl class="product-detail__facts">
            <div><dt>État</dt><dd>{conditionLabels[data.condition]}</dd></div>
            {
              data.brand && (
                <div>
                  <>
                    <dt>Marque</dt>
                    <dd>{data.brand}</dd>
                  </>
                </div>
              )
            }
            {
              data.model && (
                <div>
                  <>
                    <dt>Modèle</dt>
                    <dd>{data.model}</dd>
                  </>
                </div>
              )
            }
            {
              data.year && (
                <div>
                  <>
                    <dt>Année</dt>
                    <dd>{data.year}</dd>
                  </>
                </div>
              )
            }
            {
              data.location && (
                <div>
                  <>
                    <dt>Localisation</dt>
                    <dd>{data.location}</dd>
                  </>
                </div>
              )
            }
          </dl>

          <Button
            href="/contact"
            label="Demander des renseignements"
            variant="primary"
          />
        </div>
      </div>

      <div class="product-detail__content">
        <h2>À propos de ce matériel</h2>
        <Content />
      </div>
    </Container>
  </section>
</Layout>
