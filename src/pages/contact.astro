---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container/Container.astro";
import { site } from "../config/site";

import "../styles/contact.css";

const phoneHref = `tel:${site.phone.replaceAll(" ", "")}`;
const linkedinUrl = site.linkedin;

const contactDescription =
  "Contactez Polymaintenance pour vos besoins de maintenance, installation, formation ou matériel industriel en Ardèche, Drôme et vallée du Rhône.";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact et demande de devis – Polymaintenance",
  url: new URL(Astro.url.pathname, site.url).toString(),
  description: contactDescription,
  mainEntity: {
    "@type": "LocalBusiness",
    name: site.name,
    telephone: site.phone,
    email: site.email,
  },
};
---

<Layout
  title="Contact et demande de devis | Polymaintenance"
  description={contactDescription}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(contactPageSchema)}
  />

  <section class="contact-page">
    <Container>
      <div class="contact-page__heading">
        <p class="contact-eyebrow">Contact et demande de devis</p>
        <h1>Parlons de votre projet industriel</h1>
        <p>
          Une panne, une installation à préparer ou un besoin de matériel&nbsp;?
          Décrivez votre demande à Hervé afin d’étudier la solution la plus
          adaptée à votre activité.
        </p>
      </div>

      <div class="contact-page__grid">
        <aside class="contact-details" aria-labelledby="contact-details-title" data-reveal="left">
          <div>
            <p class="contact-eyebrow">Contact direct</p>
            <h2 id="contact-details-title">Échangez avec Hervé</h2>
            <p class="contact-details__intro">
              Pour une demande urgente ou un premier échange, vous pouvez le
              joindre directement par téléphone ou par e-mail.
            </p>
          </div>

          <address class="contact-details__list">
            <a class="contact-details__item" href={phoneHref}>
              <span class="contact-details__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
              </span>
              <span>
                <small>Téléphone</small>
                <strong>{site.phone}</strong>
              </span>
            </a>

            <a class="contact-details__item" href={`mailto:${site.email}`}>
              <span class="contact-details__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="m3 7 9 6 9-6"></path>
                </svg>
              </span>
              <span>
                <small>Adresse e-mail</small>
                <strong>{site.email}</strong>
              </span>
            </a>


            <a
              class="contact-details__item"
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Voir le profil LinkedIn d’Hervé Giaufret"
            >
              <span class="contact-details__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M6.94 8.5H3.56V19h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92A1.96 1.96 0 0 0 5.25 3ZM20.44 13c0-3.16-1.69-4.63-3.94-4.63-1.82 0-2.63 1-3.08 1.7V8.5h-3.37c.04 1.04 0 10.5 0 10.5h3.37v-5.86c0-.31.02-.63.11-.85.25-.63.81-1.28 1.76-1.28 1.24 0 1.74.95 1.74 2.34V19h3.37l.04-6Z"
                  ></path>
                </svg>
              </span>
              <span>
                <small>LinkedIn</small>
                <strong>Hervé Giaufret</strong>
                <p>Retrouvez Hervé sur LinkedIn</p>
              </span>
            </a>

            <div class="contact-details__item">
              <span class="contact-details__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
                  ></path>
                  <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
              </span>
              <span>
                <small>Adresse et zone d’intervention</small>
                <strong>
                  {site.address.street}, {site.address.postalCode} {site.address.locality}
                </strong>
                <p>Près d’Aubenas · Ardèche, Drôme et vallée du Rhône. Déplacements possibles en France et à l’international.</p>
              </span>
            </div>
          </address>
        </aside>

        <div class="contact-form-card" data-reveal="right">
          <div class="contact-form-card__heading">
            <h2>Décrivez votre besoin</h2>
            <p>Les champs marqués d’un astérisque sont obligatoires.</p>
          </div>

          <form class="contact-form" id="contact-form" action="/contact.php" method="post" accept-charset="UTF-8">
            <div class="contact-form__honeypot" aria-hidden="true">
              <label for="website">Votre site internet</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="contact-form__row">
              <div class="contact-form__field">
                <label for="name"
                  >Nom et prénom <span aria-hidden="true">*</span></label
                >
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                />
              </div>

              <div class="contact-form__field">
                <label for="company">Société <small>(facultatif)</small></label>
                <input
                  id="company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                />
              </div>
            </div>

            <div class="contact-form__row">
              <div class="contact-form__field">
                <label for="email"
                  >Adresse e-mail <span aria-hidden="true">*</span></label
                >
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="contact-form__field">
                <label for="phone">Téléphone <small>(facultatif)</small></label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                />
              </div>
            </div>

            <div class="contact-form__field">
              <label for="subject"
                >Objet de la demande <span aria-hidden="true">*</span></label
              >
              <select id="subject" name="subject" required>
                <option value="" selected disabled>Sélectionnez un sujet</option
                >
                <option value="maintenance">Maintenance ou dépannage</option>
                <option value="installation">Installation ou transfert</option>
                <option value="formation">Formation professionnelle</option>
                <option value="negoce">Recherche de matériel</option>
                <option value="autre">Autre demande</option>
              </select>
            </div>

            <div class="contact-form__field">
              <label for="message"
                >Votre message <span aria-hidden="true">*</span></label
              >
              <textarea id="message" name="message" rows="7" required
              ></textarea>
            </div>

            <p class="contact-form__privacy">
              Les informations saisies sont utilisées par Polymaintenance
              uniquement pour répondre à votre demande. Les champs marqués d’un
              astérisque sont nécessaires au traitement de celle-ci. <a
                href="/mentions-legales#donnees-personnelles"
                >En savoir plus sur l’utilisation de vos données</a
              >.
            </p>

            <button class="contact-form__submit" type="submit">
              Envoyer ma demande
            </button>

            <p
              class="contact-form__status"
              id="contact-form-status"
              role="alert"
              tabindex="-1"
              hidden
            >
              L’envoi n’a pas abouti. Vous pouvez réessayer ou écrire directement à
              <a href={`mailto:${site.email}`}>{site.email}</a>.
            </p>
          </form>
        </div>
      </div>
    </Container>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLElement>("#contact-form-status");
    const submitButton = form?.querySelector<HTMLButtonElement>(
      ".contact-form__submit",
    );

    if (new URLSearchParams(window.location.search).get("error") === "1") {
      if (status) {
        status.hidden = false;
        status.focus();
      }
    }

    form?.addEventListener("submit", () => {
      if (!form.checkValidity()) return;

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Envoi en cours…";
      }
    });
  </script>
</Layout>
